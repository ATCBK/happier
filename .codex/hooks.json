{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/formatEditedFiles.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"& node ((git rev-parse --show-toplevel) + '/scripts/formatEditedFiles.mjs')\""
          }
        ]
      }
    ]
  }
}
