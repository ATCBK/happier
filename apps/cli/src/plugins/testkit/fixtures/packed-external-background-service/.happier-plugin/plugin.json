{
  "schemaVersion": 2,
  "id": "acme.packed-background-service",
  "version": "1.0.0",
  "displayName": "Packed background service fixture",
  "engines": { "happier": "^0.2.0" },
  "runtime": { "apiVersion": 1 },
  "entrypoints": { "daemon": "./src/daemon.mjs" },
  "activation": { "events": [{ "kind": "startup" }] },
  "hostAccess": { "required": [], "optional": [] },
  "contributes": {
    "settings": [{
      "id": "indexing", "title": "Indexing", "target": { "kind": "plugin" }, "scope": "daemon",
      "fields": [{ "id": "enabled", "title": "Enabled", "schema": { "type": "boolean" }, "default": true }]
    }],
    "backgroundServices": [
      { "id": "index", "placement": "process", "activation": "demand" },
      { "id": "retirement-probe", "placement": "process", "activation": "demand" }
    ],
    "events": [
      { "id": "ready", "kind": "event", "title": "Runner ready" },
      {
        "id": "observe-ready", "kind": "subscription",
        "target": { "kind": "plugin", "event": { "pluginId": "acme.packed-background-service", "localId": "ready" } }
      }
    ],
    "actions": [
      {
        "id": "verify", "title": "Verify process demand", "scopes": ["global"],
        "surfaces": ["cli"], "execution": { "target": "daemon" }, "dangerLevel": "safe",
        "inputSchema": { "type": "object", "properties": { "runs": { "type": "integer", "enum": [1, 2] } }, "additionalProperties": false }
      },
      {
        "id": "start-held", "title": "Start held process demand", "scopes": ["global"],
        "surfaces": ["cli"], "execution": { "target": "daemon" }, "dangerLevel": "safe"
      },
      {
        "id": "host-echo", "title": "Echo from the daemon", "scopes": ["global"],
        "surfaces": ["plugin"], "execution": { "target": "daemon" }, "dangerLevel": "safe"
      },
      {
        "id": "wait-held", "title": "Wait for the held runner", "scopes": ["global"],
        "surfaces": ["cli"], "execution": { "target": "daemon" }, "dangerLevel": "safe"
      },
      {
        "id": "probe-state", "title": "Read runner probe state", "scopes": ["global"],
        "surfaces": ["cli"], "execution": { "target": "daemon" }, "dangerLevel": "safe"
      }
    ]
  }
}
