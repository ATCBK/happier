{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "es2020",
      "es2022"
    ],
    "jsx": "react",
    "rootDir": "../..",
    "outDir": "dist/.tsc",
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // Test tooling shares native Node TypeScript entrypoints; preserve their runtime .ts imports.
    "allowImportingTsExtensions": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/cli.typecheck.tsbuildinfo",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      // Packaging and author examples can contain installed SDK/UI copies.
      // The authored host graph uses one prepared workspace declaration identity.
      "@happier-dev/plugin-sdk": [
        "../../packages/plugin-sdk/dist/index.d.ts"
      ],
      "@happier-dev/plugin-sdk/*": [
        "../../packages/plugin-sdk/dist/*/index.d.ts",
        "../../packages/plugin-sdk/dist/*.d.ts"
      ],
      "@happier-dev/plugin-ui": [
        "../../packages/plugin-ui/dist/index.d.ts"
      ],
      "@happier-dev/plugin-ui/*": [
        "../../packages/plugin-ui/dist/*/index.d.ts",
        "../../packages/plugin-ui/dist/*.d.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/*.composed.*",
    // Self-declared temporary measurement scratch. Files named `*.tmp.test.ts` are written
    // to record a number and deleted afterwards, and while they exist they may import
    // directly across package boundaries, which pulls foreign sources into this program and
    // fails `rootDir`. Transient scratch must not be able to break the package build.
    "src/**/*.tmp.test.ts",
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
