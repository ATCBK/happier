{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node scripts/build.mjs",
    "check:content": "node scripts/checkContent.mjs",
    "generate:reference": "node scripts/generateReference.mjs",
    "test": "../stack/bin/hstack-exec --script=test:local",
    "test:local": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.mjs\"",
    "dev": "next dev",
    "start": "next start",
    "types:check": "node scripts/prepareNextTypegen.mjs && next typegen && fumadocs-mdx && node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit",
    "postinstall:real": "fumadocs-mdx",
    "postinstall": "node -e \"const fs=require('fs');if(/(^|[\\\\\\\\/])node_modules([\\\\\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'docs',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('content'))process.exit(0);import('../../scripts/workspaces/execPnpmCommand.mjs').then(({execPnpm})=>{execPnpm(['--silent','run','postinstall:real'],{stdio:'inherit'});}).catch(error=>{console.error(error.message);process.exit(error.status??1);});\""
  },
  "dependencies": {
    "fumadocs-core": "16.4.11",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-ui": "16.4.11",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "posthog-js": "1.414.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  }
}
