    "sources/app/api/routes/session/sessionFollowRoutes.sqlite.integration.spec.ts",
    "sources/app/api/socket/sessionUpdateHandler.sqlite.integration.spec.ts",
    "sources/app/artifacts/artifactCreateRecovery.sqlite.integration.spec.ts",
    "sources/app/changes/accountPublicationContention.postgres.dbcontract.spec.ts",
    "sources/app/machines/managed/managedAcquire.integration.spec.ts",
    "sources/app/machines/managed/managedFiniteWake.sqlite.integration.spec.ts",
    "sources/app/session/follow/accountFollowRuleService.sqlite.integration.spec.ts",
    // These Home search specs share the packages/tests performance fixture ids.
    "sources/app/search/homeSearchStartApi.sqlite.integration.spec.ts",
    "sources/app/search/readHomeSearchVisibleSessionConstraints.postgres.dbcontract.spec.ts",
    // Browser code and its unit fixture are checked by tsconfig.publicViewer.json.
    "sources/app/api/routes/share/artifactHtmlViewer.ts",
    "sources/app/api/routes/share/publicDeclarativeViewer.ts",
    "sources/app/api/routes/share/publicShareViewerBrowser.ts",
    "sources/app/api/routes/share/publicShareViewerClient.ts",
    "sources/app/api/routes/share/publicShareViewerClient.test.ts",
    "sources/app/api/routes/share/publicSessionVisuals.ts"
  ]
}
