{
  "id": "J11",
  "intent": "Open Search/command palette through its real rail control, resolve an Account command query, close/reopen, search the existing R9-TAIL Session metadata fixture, clear and dismiss. Requires the prepared English QA Account described in lanes/B3.md; does not execute a mutating command.",
  "prepare": [{ "op": "open" }, { "op": "home" }],
  "steps": [
    { "op": "browser", "args": ["click", "[data-testid=\"app-rail:search\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"universal-search-host\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"selection-list:header:input\"]"] },
    { "op": "browser", "args": ["fill", "[data-testid=\"selection-list:header:input\"]", "account"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"command-palette:option:account\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"universal-search:close\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"app-rail:search\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"selection-list:header:input\"]"] },
    { "op": "browser", "args": ["fill", "[data-testid=\"selection-list:header:input\"]", "R9-TAIL"] },
    { "op": "browser", "args": ["wait", "[data-testid^=\"universal-search:option:sessions:\"]"] },
    { "op": "browser", "args": ["fill", "[data-testid=\"selection-list:header:input\"]", ""] },
    { "op": "browser", "args": ["click", "[data-testid=\"universal-search:close\"]"] },
    { "op": "browser", "args": ["wait", "--fn", "!document.querySelector('[data-testid=\"universal-search-host\"]')"] }
  ]
}
