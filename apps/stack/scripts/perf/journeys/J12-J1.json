{
  "id": "J12-J1",
  "intent": "J12 at 390x844 CSS pixels: Cold document startup and dev Account restore through authenticated Home; warm mode measures authenticated reload.",
  "prepare": [
    {
      "op": "browser",
      "args": [
        "set",
        "viewport",
        "390",
        "844"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "--fn",
        "window.innerWidth === 390"
      ]
    }
  ],
  "steps": [
    {
      "op": "open"
    },
    {
      "op": "browser",
      "when": "cold",
      "args": ["wait", "[data-testid=\"onboarding-showcase-story-skip\"]"]
    },
    {
      "op": "browser",
      "when": "cold",
      "args": ["click", "[data-testid=\"onboarding-showcase-story-skip\"]"]
    },
    {
      "op": "browser",
      "when": "cold",
      "args": ["wait", "[data-testid=\"onboarding-showcase-story-skip\"]", "--state", "detached"]
    },
    {
      "op": "browser",
      "when": "cold",
      "args": ["wait", "[data-testid=\"brand-hero-get-started\"], [data-testid=\"welcome-login-provider\"]"]
    },
    {
      "op": "browser",
      "when": "cold",
      "args": ["click", "[data-testid=\"brand-hero-get-started\"], [data-testid=\"welcome-login-provider\"]"]
    },
    {
      "op": "restore",
      "when": "cold"
    },
    {
      "op": "browser",
      "args": ["eval", "(() => { if (innerWidth !== 390) throw new Error('Phone viewport changed during startup/restore'); return true; })()"]
    },
    {
      "op": "home"
    }
  ]
}
