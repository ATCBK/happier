{
  "id": "J12-J5",
  "intent": "J12 at 390x844 CSS pixels: Open ordinary New Session, reselect the prepared agent/model and exact perf Machine through their real pickers, then submit one harmless first message and observe it in the new transcript. Requires B8 round-1 target and draft preparation described in lanes/B8.md. Round 1: exact agent-qa-perf Machine 620a8bc8-99ec-461a-87f7-2b980ac7a68c, observed from its server-scoped CLI settings; use a B8-owned ordinary draft and stop on missing/ambiguous controls. At phone width bind the sheet selectors after first live inspection; no arbitrary selection. First-message execution is blocked until this exact Machine has an admitted authenticated Agent; do not switch to a foreign Machine to satisfy it.",
  "prepare": [
    {
      "op": "browser",
      "args": [
        "set",
        "viewport",
        "390",
        "844"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "--fn",
        "window.innerWidth === 390"
      ]
    },
    {
      "op": "open"
    },
    {
      "op": "home"
    }
  ],
  "steps": [
    {
      "op": "open",
      "path": "/new"
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "[data-testid=\"new-session-composer-input\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "focus",
        "[data-testid=\"new-session-composer-input\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "type",
        "[data-testid=\"new-session-composer-input\"]",
        "perf-B8: Reply with PERF_E2E_B8_OK only. Do not run tools or change files."
      ]
    },
    {
      "op": "browser",
      "args": [
        "click",
        "[data-testid=\"agent-input-machine-chip\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "[data-testid=\"new-session-machine-option:620a8bc8-99ec-461a-87f7-2b980ac7a68c\"]:not([aria-disabled=\"true\"])"
      ]
    },
    {
      "op": "browser",
      "args": [
        "click",
        "[data-testid=\"new-session-machine-option:620a8bc8-99ec-461a-87f7-2b980ac7a68c\"]:not([aria-disabled=\"true\"])"
      ]
    },
    {
      "op": "browser",
      "args": [
        "click",
        "[data-testid=\"agent-input-agent-chip\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "[data-testid=\"agent-input-chip-picker.sheet-back\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "click",
        "[data-testid=\"agent-input-chip-picker.sheet-back\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "[data-testid=\"agent-input-chip-picker.option:agent:happier.agent.claude/claude\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "click",
        "[data-testid=\"agent-input-chip-picker.option:agent:happier.agent.claude/claude\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "[data-testid=\"model-picker-overlay-selection-list\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "click",
        "[data-testid^=\"model-picker-overlay-option:\"][aria-selected=\"true\"]:not([aria-disabled=\"true\"])"
      ]
    },
    {
      "op": "browser",
      "args": [
        "press",
        "Escape"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "--fn",
        "document.querySelector('[data-testid=\"new-session-composer-input\"]')?.value === 'perf-B8: Reply with PERF_E2E_B8_OK only. Do not run tools or change files.'"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "--fn",
        "(() => { const e = document.querySelector('[data-testid=\"new-session-composer-send\"]'); return e && !e.disabled && e.getAttribute('aria-disabled') !== 'true'; })()"
      ]
    },
    {
      "op": "browser",
      "args": [
        "click",
        "[data-testid=\"new-session-composer-send\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "[data-testid=\"session-composer-input\"]"
      ]
    },
    {
      "op": "browser",
      "args": [
        "wait",
        "[data-testid^=\"transcript-message-actions-row:\"]"
      ]
    }
  ]
}
