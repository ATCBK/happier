{
  "id": "J3",
  "intent": "Scroll the populated Session list, apply the Needs me facet, then restore it. Start from the recorded unfiltered view; wheel movement and resulting membership must be verified on the loaded export before baseline capture.",
  "prepare": [
    { "op": "open" },
    { "op": "home" },
    { "op": "browser", "args": ["wait", "[data-testid^=\"session-list-item-\"]"] },
    { "op": "browser", "args": ["eval", "(() => { if (document.querySelector('[data-testid=\"session-list-filter-trigger-narrowed\"]')) throw new Error('J3 requires the recorded unfiltered baseline'); return true; })()"] },
    { "op": "browser", "args": ["scroll", "up", "100000", "--selector", "[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]"] },
    { "op": "browser", "args": ["wait", "--fn", "document.querySelector('[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]')?.scrollTop === 0"] }
  ],
  "steps": [
    { "op": "browser", "args": ["scroll", "down", "720", "--selector", "[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]"] },
    { "op": "browser", "args": ["scroll", "down", "720", "--selector", "[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]"] },
    { "op": "browser", "args": ["scroll", "down", "720", "--selector", "[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]"] },
    { "op": "browser", "args": ["wait", "--fn", "document.querySelector('[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]')?.scrollTop > 0"] },
    { "op": "browser", "args": ["scroll", "up", "720", "--selector", "[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]"] },
    { "op": "browser", "args": ["scroll", "up", "720", "--selector", "[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]"] },
    { "op": "browser", "args": ["scroll", "up", "720", "--selector", "[data-testid=\"session-list-content\"] > div[style*=\"overflow: auto\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"session-list-filter-trigger\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"session-list-filter-panel\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"session-list-filter-attention\"]"] },
    { "op": "browser", "args": ["wait", "--fn", "!!document.querySelector('[data-testid=\"session-list-filter-trigger-narrowed\"]') && !document.querySelector('[data-testid=\"session-list-query-status\"]') && !!document.querySelector('[data-testid^=\"session-list-item-\"], [data-testid=\"session-list-query-empty-state\"], [data-testid=\"session-list-filtered-no-results\"]')"] },
    { "op": "browser", "args": ["click", "[data-testid=\"session-list-filter-attention\"]"] },
    { "op": "browser", "args": ["wait", "--fn", "!document.querySelector('[data-testid=\"session-list-filter-trigger-narrowed\"]') && !document.querySelector('[data-testid=\"session-list-query-status\"]') && !!document.querySelector('[data-testid^=\"session-list-item-\"]')"] }
  ]
}
