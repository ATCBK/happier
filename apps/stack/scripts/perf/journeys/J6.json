{
  "id": "J6",
  "intent": "Authenticated desktop Account Settings: Plugins, Connected services, Actions/approvals policy, Appearance, Plugins revisit. Measure each panel as rendered on this device, including no-Machine or locked-Machine states. A Machine is not a prerequisite for Account settings. Do not mutate preferences or install plugins.",
  "prepare": [
    { "op": "open" },
    { "op": "home" },
    { "op": "idle", "ms": 90000 }
  ],
  "steps": [
    { "op": "browser", "args": ["click", "[data-testid=\"app-rail:settings\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"settings-sidebar.item.plugins\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"settings-sidebar.item.plugins\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"settings.plugins.page\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"settings-sidebar.item.connectedServices\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"settings-connected-services-layout\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"connected-services-summary\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"settings-sidebar.item.actions\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"settings-actions:virtualized-list\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"settings-sidebar.item.appearance\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"settings-appearance-themeMode\"]"] },
    { "op": "browser", "args": ["click", "[data-testid=\"settings-sidebar.item.plugins\"]"] },
    { "op": "browser", "args": ["wait", "[data-testid=\"settings.plugins.page\"]"] }
  ]
}
