# Happier: expose the vendor-owned web initializer as a public subpath for the
# portable Voice plugin graph. The universal compiler does not select `browser`;
# importing this subpath lazily on web registers the SDK's existing media strategy.
# Version pinned to @elevenlabs/client 1.18.0; no vendor implementation is copied.
diff --git a/node_modules/@elevenlabs/client/package.json b/node_modules/@elevenlabs/client/package.json
--- a/node_modules/@elevenlabs/client/package.json
+++ b/node_modules/@elevenlabs/client/package.json
@@ -12,6 +12,10 @@
       "browser": "./dist/platform/web/index.js",
       "default": "./dist/index.js"
     },
+    "./web": {
+      "types": "./dist/platform/web/index.d.ts",
+      "default": "./dist/platform/web/index.js"
+    },
     "./internal": "./dist/internal.js",
     "./internal/unity": "./dist/internal/unity.js",
     "./worklets/*": "./worklets/*"
