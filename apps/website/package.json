{
  "name": "@happier-dev/website",
  "description": "Marketing site for Happier — the control room for your AI coding agents, on every device.",
  "private": true,
  "version": "0.2.10",
  "type": "module",
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "prepare:workspace-deps": "node ../../scripts/workspaces/ensureWorkspacePackagesBuiltCli.mjs --for-component=apps/website",
    "pregenerate:plugin-manifest-schema": "pnpm --silent run prepare:workspace-deps",
    "generate:plugin-manifest-schema": "node scripts/generate-plugin-manifest-schema.mjs",
    "pregenerate:marketplace-catalog": "pnpm --silent run prepare:workspace-deps",
    "generate:marketplace-catalog": "node scripts/generate-marketplace-catalog.mjs",
    "prebuild": "pnpm --silent run generate:plugin-manifest-schema && pnpm --silent run generate:marketplace-catalog && pnpm --silent run i18n:extract && pnpm --silent run optimize:images",
    "predev": "pnpm --silent run generate:plugin-manifest-schema && pnpm --silent run generate:marketplace-catalog",
    "dev": "vite",
    "build": "pnpm --silent run build:server && pnpm --silent run i18n:slice && node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit && pnpm --silent run build:client && pnpm --silent run build:server && pnpm --silent run prune:source-images && pnpm --silent run prerender && pnpm --silent run assert:crawlable && pnpm --silent run assert:locale-links && pnpm --silent run assert:perf",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx",
    "prerender": "node scripts/prerender.mjs",
    "prune:source-images": "node scripts/prune-source-images.mjs",
    "assert:crawlable": "node scripts/assert-crawlable.mjs",
    "assert:locale-links": "node scripts/assert-locale-links.mjs",
    "assert:perf": "node scripts/assert-perf-budget.mjs",
    "check:links": "node --experimental-strip-types scripts/check-download-links.mjs",
    "preview": "vite preview",
    "test": "../stack/bin/hstack-exec --script=test:local",
    "pretest:local": "pnpm --silent run prepare:workspace-deps",
    "test:local": "vitest run --exclude scripts/**/*.test.mjs && node --test scripts/*.test.mjs",
    "typecheck": "../stack/bin/hstack-exec --script=typecheck:local",
    "pretypecheck:local": "pnpm --silent run prepare:workspace-deps",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit",
    "optimize:images": "node scripts/optimize-images.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check",
    "verify:analytics": "node scripts/verify-analytics.mjs",
    "i18n:slice": "node scripts/i18n-slice-overlays.mjs"
  },
  "dependencies": {
    "@happier-dev/brand": "0.0.0",
    "@happier-dev/protocol": "0.0.0",
    "clsx": "^2.1.1",
    "posthog-js": "1.414.0",
    "preact": "10.28.4",
    "preact-render-to-string": "6.6.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "vite": "^6.4.1"
  }
}
