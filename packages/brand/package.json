{
  "name": "@happier-dev/brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./planet": {
      "types": "./planet.d.mts",
      "default": "./planet.mjs"
    },
    "./planet-moments": {
      "types": "./planet-moments.d.mts",
      "default": "./planet-moments.mjs"
    },
    "./planet-placement": {
      "types": "./planet-placement.d.mts",
      "default": "./planet-placement.mjs"
    },
    "./atmosphere": {
      "types": "./atmosphere.d.mts",
      "default": "./atmosphere.mjs"
    },
    "./atmosphere-haze": {
      "types": "./atmosphere-haze.d.mts",
      "default": "./atmosphere-haze.mjs"
    },
    "./product-story": {
      "happier-source": "./src/product-story.ts",
      "types": "./dist/product-story.d.ts",
      "default": "./dist/product-story.js"
    }
  },
  "files": [
    "dist",
    "planet.mjs",
    "planet.d.mts",
    "planet-moments.mjs",
    "planet-moments.d.mts",
    "planet-placement.mjs",
    "planet-placement.d.mts",
    "atmosphere.mjs",
    "atmosphere.d.mts",
    "atmosphere-haze.mjs",
    "atmosphere-haze.d.mts",
    "package.json"
  ],
  "scripts": {
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "node --test planet.test.mjs atmosphere.test.mjs planet-moments.test.mjs planet-placement.test.mjs scripts/parityAssertions.test.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "prepack": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "color": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
