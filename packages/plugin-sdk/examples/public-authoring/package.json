{
  "name": "@example/happier-public-authoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./happier-plugin-ui/review-native": "./ui/reviewPanelPortable.tsx",
    "./happier-plugin-ui/review-openable-native": "./ui/reviewPanelPortable.tsx",
    "./happier-plugin-ui/review-client-actions": "./ui/reviewClientActions.ts",
    "./happier-plugin-ui/voice-runtime-web": "./voiceProvider.ts"
  },
  "description": "Production-shaped public Happier SDK authoring reference.",
  "happier": {
    "manifest": ".happier-plugin/plugin.json"
  },
  "keywords": [
    "happier-plugin"
  ],
  "files": [
    "dist",
    "resources",
    ".happier-plugin/ui/hosted-web/review-openable-web/entry.ts",
    ".happier-plugin/ui/hosted-web/review-openable-web/index.html",
    ".happier-plugin/ui/hosted-web/review-web/entry.ts",
    ".happier-plugin/ui/hosted-web/review-web/index.html"
  ],
  "scripts": {
    "build": "happier plugins dev build .",
    "build:ui": "happier-plugin-build-ui --project-root .",
    "typecheck": "happier plugins dev typecheck .",
    "test": "happier plugins test .",
    "pack:plugin": "happier plugins pack ."
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.5",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "@types/react": "19.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "5.9.3"
  }
}
