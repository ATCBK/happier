{
  "name": "@happier-dev/example-react-native-installed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./happier-plugin-ui/panel-native": "./ui/panel.native.tsx"
  },
  "description": "Installed React Native Happier plugin example.",
  "happier": {
    "manifest": ".happier-plugin/plugin.json"
  },
  "keywords": [
    "happier-plugin"
  ],
  "files": [
    "dist",
    ".happier-plugin"
  ],
  "scripts": {
    "build": "happier plugins dev build .",
    "build:ui": "happier-plugin-build-ui --project-root .",
    "typecheck": "happier plugins dev typecheck .",
    "test": "happier plugins test .",
    "pack:plugin": "happier plugins pack ."
  },
  "dependencies": {
    "@happier-dev/plugin-sdk": "0.0.0",
    "@happier-dev/plugin-ui": "0.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.5",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.0",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "typescript": "5.9.3"
  }
}
