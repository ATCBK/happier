    "providers": [
      {
        "catalog": {
          "manualModelPolicy": "allowed",
          "probes": [
            {
              "endpointTemplateId": "cliproxyapi-openai-responses",
              "parser": "openai-models",
              "path": "/v1/models"
            }
          ],
          "source": "probe",
          "sourceRegistryVersion": "v7.2.95"
        },
        "credential": {
          "kind": "apiKey",
          "required": false,
          "slotId": "apiKey",
          "transports": [
            {
              "destination": {
                "format": "bearer",
                "kind": "httpHeader",
                "name": "authorization"
              },
              "id": "cliproxyapi-http-bearer",
              "protocols": [
                "openai-chat",
                "openai-responses",
                "anthropic"
              ],
              "uses": [
                "probe",
                "runtime"
              ]
            }
          ]
        },
        "discovery": {
          "availabilityProbe": {
            "endpointTemplateId": "cliproxyapi-openai-responses",
            "parser": "openai-models",
            "path": "/v1/models"
          },
          "listener": {
            "defaultPorts": [
              8317
            ],
            "executableBasenames": [
              "CLIProxyAPI",
              "CLIProxyAPI.exe",
              "cli-proxy-api",
              "cli-proxy-api.exe"
            ]
          },
          "v": 1
        },
        "endpointTemplates": [
          {
            "capabilities": {
              "reasoningControls": "supported",
              "statefulResponses": "unknown",
              "streaming": "supported",
              "toolRoundTrips": "supported"
            },
            "id": "cliproxyapi-openai-responses",
            "localUrlCandidates": [
              "http://127.0.0.1:8317/v1",
              "http://localhost:8317/v1"
            ],
            "protocol": "openai-responses"
          },
          {
            "capabilities": {
              "reasoningControls": "unknown",
              "statefulResponses": "unknown",
              "streaming": "supported",
              "toolRoundTrips": "supported"
            },
            "id": "cliproxyapi-openai-chat",
            "localUrlCandidates": [
              "http://127.0.0.1:8317/v1",
              "http://localhost:8317/v1"
            ],
            "protocol": "openai-chat"
          },
          {
            "capabilities": {
              "reasoningControls": "supported",
              "statefulResponses": "unknown",
              "streaming": "supported",
              "toolRoundTrips": "supported"
            },
            "id": "cliproxyapi-anthropic",
            "localUrlCandidates": [
              "http://127.0.0.1:8317/",
              "http://localhost:8317/"
            ],
            "protocol": "anthropic"
          }
        ],
        "id": "cliproxyapi",
        "kind": "aggregator",
        "managedRuntime": {
          "connectedAccountPurposeBindingPolicy": {
            "minimumBound": 1
          },
          "connectedAccounts": [
            {
              "endpointTemplateIds": [
                "cliproxyapi-openai-chat",
                "cliproxyapi-openai-responses",
                "cliproxyapi-anthropic"
              ],
              "materializationKinds": [
                "httpHeaders"
              ],
              "purpose": "openai-upstream",
              "required": false,
              "service": {
                "localId": "openai-codex",
                "pluginId": "happier.agent.codex"
              },
              "title": {
                "fallback": "ChatGPT account or pool",
                "key": "managedPurpose.openai.title"
              }
            },
            {
              "endpointTemplateIds": [
                "cliproxyapi-openai-chat",
                "cliproxyapi-openai-responses",
                "cliproxyapi-anthropic"
              ],
              "materializationKinds": [
                "httpHeaders"
              ],
              "purpose": "anthropic-upstream",
              "required": false,
              "service": {
                "localId": "claude-subscription",
                "pluginId": "happier.agent.claude"
              },
              "title": {
                "fallback": "Claude account or pool",
                "key": "managedPurpose.anthropic.title"
              }
            }
          ],
          "endpointTemplateIds": [
            "cliproxyapi-openai-chat",
            "cliproxyapi-openai-responses",
            "cliproxyapi-anthropic"
          ],
          "kind": "managed",
          "requestAuthUses": [
            {
              "materialization": {
                "headerNames": [
                  "authorization",
                  "chatgpt-account-id"
                ],
                "kind": "httpHeaders",
                "origin": "https://chatgpt.com"
              },
              "purpose": "openai-upstream"
            },
            {
              "materialization": {
                "headerNames": [
                  "authorization"
                ],
                "kind": "httpHeaders",
                "origin": "https://api.anthropic.com"
              },
              "purpose": "anthropic-upstream"
            }
          ],
          "sharing": "connectionMachine"
        },
        "name": "CLIProxyAPI",
        "v": 1,
        "websiteUrl": "https://github.com/router-for-me/CLIProxyAPI"
      }
    ],
