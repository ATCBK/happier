{
  "name": "@happier-dev/voice-modelpacks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "happier-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "vitest run --config ../../vitest.config.ts",
    "postinstall:real": "pnpm --silent run build",
    "postinstall": "node -e \"const fs=require('fs');if(/(^|[\\\\\\\\/])node_modules([\\\\\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'voice-modelpacks',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('tsconfig.json'))process.exit(0);import('../../scripts/workspaces/execPnpmCommand.mjs').then(({execPnpm})=>{execPnpm(['--silent','run','postinstall:real'],{stdio:'inherit'});}).catch(error=>{console.error(error.message);process.exit(error.status??1);});\"",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@happier-dev/protocol": "0.0.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
